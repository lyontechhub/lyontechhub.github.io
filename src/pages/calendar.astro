---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <div class="section">
        <div class="container">
            <p class="title">
              Le calendrier partagé par toutes les communautés lyonnaises
            </p>
            <p class="subtitle">
              Venez rencontrer toutes ces communautés et leurs participants !
            </p>
            <p><span class="icon is-medium"><i class="fa fa-calendar"></i></span>Ajouter le calendrier des nouveaux événements à vos calendriers 
                <a href="https://www.lyontechhub.org/Lyon-Tech-Hub-Calendar/calendar.ics">au format ical</a>.</p>

            <nav class="navbar is-justify-content-center calendar-header">
                <button type="button" class="button is-default nav-item" id="calendarToday">Aujourd'hui</button>
                <button type="button" class="button is-default nav-item" id="calendarPrevious" aria-label="Mois précédent">
                <span class="icon is-medium">
                  <i class="fa fa-chevron-left fa-lg" aria-hidden="true"></i>
                </span>
                </button>
                <button type="button" class="button is-default nav-item" id="calendarNext" aria-label="Mois suivant">
                <span class="icon is-medium">
                  <i class="fa fa-chevron-right fa-lg" aria-hidden="true"></i>
                </span>
                </button>
                <span id="calendarDate" aria-live="polite" aria-atomic="true"></span>
            </nav>

            <nav class="navbar is-justify-content-center calendar-header calendar-mobile-header">
                <button type="button" class="button is-default nav-item" id="calendarMobileToday">Aujourd'hui</button>
                <button type="button" class="button is-default nav-item" id="calendarMobilePrevious" aria-label="Période précédente">
                <span class="icon is-medium">
                  <i class="fa fa-chevron-left fa-lg" aria-hidden="true"></i>
                </span>
                </button>
                <button type="button" class="button is-default nav-item" id="calendarMobileNext" aria-label="Période suivante">
                <span class="icon is-medium">
                  <i class="fa fa-chevron-right fa-lg" aria-hidden="true"></i>
                </span>
                </button>
                <span id="calendarMobileRange" aria-live="polite" aria-atomic="true"></span>
            </nav>

            <div id="calendar"></div>
            <div id="calendarMobileList"
                 data-pane-title="Événements à venir"
                 data-no-event-caption="Pas d'événement sur cette période. Essayez la période suivante."></div>
        </div>
    </div>
  </main>
</Layout>
