---
import Layout from '../layouts/Layout.astro';
import {getList} from '../lib/communities.ts';

const communities = getList();
---

<Layout>
    <main>
        <div class="section">
            <div class="container">
                <p class="title">
                    {communities.length} communautés variées regroupées dans Lyon Tech Hub
                </p>
                <div class="search-header">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input class="search-input" type="text" id="filterCommunities"
                               placeholder="Rechercher"/>
                    </div>
                    <a href="/about" class="search-header-link">Par ici pour référencer la votre !</a>
                </div>
                <div class="grid is-col-min-10">
                    {communities
                        .map(
                            (community) => (
                                <a class="lth-card lth-card-reference filterable" href={`/community/` + community.key}
                                   data-key={community.name}>
                                    <p class="lth-card-title">{community.name}</p>
                                    <img src={`/imgs/communities/` + community.image}
                                         alt={community.name}
                                         data-fallback="/imgs/noLogo.png"
                                    /><span class="learn-more">En savoir plus</span>
                                </a>
                            )
                        )
                    }
                </div>
            </div>
        </div>
    </main>
</Layout>
