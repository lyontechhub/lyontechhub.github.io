---
import Layout from '../layouts/Layout.astro';

interface Conference {
    key: string;
    name: string;
    url: string;
    image: string;
    shortDescription: string;
    tags: string[];
}

const globFiles: Record<string, {default: Conference[]}> = import.meta.glob('../../data/conferences.json', { eager: true });
const conferences: Conference[] = globFiles['../../data/conferences.json'].default;
---

<Layout>
  <main>
    <div class="section">
        <div class="container">
            <p class="title">
              {conferences.length} conférences organisées par les communautés du LyonTechHub
            </p>
            <div class="search-header">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input class="search-input" type="text" id="filterConferences"
                           onkeyup="dynamicFilter('filterConferences')" placeholder="Rechercher"/>
                </div>
                <a href="/about" class="search-header-link">Par ici pour référencer la votre !</a>
            </div>
            <div class="grid is-col-min-10">
                {conferences
                    .map(
                        (conference) => (
                            <a class="lth-card lth-card-reference filterable" href={conference.url}
                               data-key={conference.name} target="_blank">
                                <p class="lth-card-title">{conference.name}</p>
                                <img src={"/imgs/conferences/" + conference.image}
                                     alt={conference.name}
                                     onerror="this.onerror=null;this.src='/imgs/noLogo.png';"
                                />
                                <p class="lth-card-text">{conference.shortDescription}</p>
                                <span class="learn-more">En savoir plus</span>
                            </a>
                        )
                    )
                }
            </div>
        </div>
    </div>
  </main>
</Layout>
